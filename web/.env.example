# Haratna website — environment variables (set them in Vercel → Project → Settings → Environment Variables).

# Public origin of the website once the domain is live, e.g. https://<your-domain>.
# Used for canonical URLs, hreflang, the sitemap and Open Graph. Never invent a value.
NEXT_PUBLIC_SITE_URL=

# Supabase project that stores support tickets (same project as the app).
# Server-side only: these are read in the /api/support route handler and never sent
# to the browser. The publishable (anon) key is enough: tickets are written through
# the submit_public_support_request() database function, which validates input and
# rate-limits. NEVER put a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Email through Resend (https://resend.com). Server-side only; never shown in the dashboard.
# RESEND_API_KEY + SUPPORT_REPLY_FROM enable "Save & send email" replies from /admin.
# SUPPORT_REPLY_FROM must use a domain verified in Resend, e.g. "حارتنا Haratna <support@<your-domain>>".
RESEND_API_KEY=
SUPPORT_REPLY_FROM=
# Optional: where customer replies to support emails go (defaults to SUPPORT_REPLY_FROM).
SUPPORT_REPLY_TO=
# Optional: also email each NEW website ticket to the support inbox.
SUPPORT_NOTIFY_FROM=
SUPPORT_NOTIFY_TO=
# Tests only: point Resend calls at a local stub. Leave unset in production.
# RESEND_API_URL=
