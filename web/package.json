{
  "name": "haratna-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official Haratna (\u062d\u0627\u0631\u062a\u0646\u0627) website and support portal.",
  "scripts": {
    "sync-content": "node scripts/sync-content.mjs",
    "predev": "node scripts/sync-content.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-content.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts src/lib/admin/*.test.ts",
    "e2e": "playwright test",
    "e2e:admin": "playwright test -c playwright.admin.config.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
