# Haratna environment variables
#
# The app talks to the Haratna Supabase project. Its URL and *publishable*
# anon key are compiled in as defaults (src/lib/supabase.ts) — they are safe
# to ship: all data access is enforced by Row Level Security on the server.
# Override them here only to point a build at a different (e.g. staging)
# project. Only EXPO_PUBLIC_* variables are bundled into the app.

# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable anon key>

# Haratna's real web domain, once registered — used by src/config/links.ts
# for share links instead of the haratna:// scheme. Never invent a value.
# EXPO_PUBLIC_WEB_BASE_URL=

# --- Server-side only — NEVER prefix with EXPO_PUBLIC_, never put in the app ---
# SUPABASE_SERVICE_ROLE_KEY=   (used only by the delete-account Edge Function,
#                               where Supabase injects it automatically)
