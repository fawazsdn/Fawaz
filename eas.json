{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "google-testflight": {
      "extends": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6821993919"
      }
    }
  }
}
